# ═══════════════════════════════════════════════════════════════════════════
# FAERIE-VAULT — Runtime Environment
# ═══════════════════════════════════════════════════════════════════════════
# Legend:
#   [REQUIRED]            → must be set for the app to start
#   [OPTIONAL: <feature>] → only needed if you use that feature
#   [DEV] / [PROD]        → environment-specific
#   [SECRET]              → do NOT share. Rotate if leaked.
#
# faerie-vault is the Obsidian vault — operational knowledge home. Most of
# its config is via Obsidian plugins. This file carries only the vault-side
# B2 backup config and the optional MCP token used by the hive plugin to
# POST human annotations back to faerie.
# ═══════════════════════════════════════════════════════════════════════════

# ─── VAULT BACKUP (B2 WORM) ────────────────────────────────────────────────
# [OPTIONAL: durable vault backup] Same B2 account as the main faerie2 repo
# OR a separate vault-only bucket. Pick one model and stick with it.

B2_ACCOUNT_ID=YOUR-B2-KEY-ID                  # [SECRET]
B2_APPLICATION_KEY=YOUR-B2-APP-KEY            # [SECRET]
B2_BUCKET_NAME=faerie-vault-backup            # [OPTIONAL] default below
B2_BUCKET_REGION=us-west-002

# [OPTIONAL] restic repository URI for vault snapshots.
# RESTIC_REPOSITORY=b2:faerie-vault-backup:vault
# RESTIC_PASSWORD=  # [SECRET]

# ─── HIVE PLUGIN → FAERIE MCP ──────────────────────────────────────────────
# [OPTIONAL: human annotations + MCP tool calls from inside Obsidian]
# Token also lives at vault-root/.faerie-token for the hive plugin to read.

FAERIE_MCP_URL=https://api.retrofuture.tech
FAERIE_API_TOKEN=  # [SECRET]

# [DEV] Local override — point at localhost MCP during development.
# FAERIE_MCP_URL=http://localhost:8080

# ─── CANONICAL PATH ANCHORS (informational) ────────────────────────────────
# These vars are read by faerie2 scripts, not by the vault itself. Listed
# here so vault contributors can mirror them locally if they run faerie2
# scripts from inside this repo.
# FAERIE_VAULT_PATH=/mnt/d/0local/gitrepos/faerie-vault   # [DEV]
# FAERIE_VAULT_PATH=/opt/faerie-vault                     # [PROD]
