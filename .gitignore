# Obsidian cache & temp files
.obsidian/cache/
.obsidian/workspace
.obsidian/*.json
!.obsidian/app.json
!.obsidian/appearance.json
!.obsidian/core-plugins.json
!.obsidian/community-plugins.json
!.obsidian/hotkeys.json
!.obsidian/command-palette.json
!.obsidian/agent-config.json

# Plugin node_modules (reinstalled on vault open)
.obsidian/plugins/*/node_modules/
.obsidian/plugins/**/package-lock.json
.obsidian/plugins/hive-pdf/

# Large cache files
.obsidian/copilot-index-*.json

# Generated files
.obsidian/graph.json
.obsidian/daily-notes.json
.obsidian/switcher.json
.obsidian/templates.json
.obsidian/backlink.json

# Theme files (users choose their own)
.obsidian/themes/*/

# System files
.DS_Store
Thumbs.db
*.tmp

# Git files
.git/
.gitignore

# Plugin secrets (API keys, license keys in plaintext)
.obsidian/plugins/share-note/data.json
.obsidian/plugins/copilot/data.json

# Node modules anywhere — never commit, reinstall from package.json
**/node_modules/

# ───────────────────────────────────────────────────────────────────────────
# VAULT PURITY RULE — Markdown only, plus Obsidian settings/config.
#
# Anything that isn't .md (or under .obsidian/) is ignored by default.
# Add explicit !-rules at the bottom for any deliberate exception
# (e.g. an .excalidraw.md is a markdown wrapper and IS allowed because
# it ends in .md). Non-readable files belong in a repo, not the vault.
# ───────────────────────────────────────────────────────────────────────────

# Ignore everything by default…
*
# …but keep all directories so we can descend
!*/
# …and explicitly allow only markdown files
!*.md
# …and the gitignore itself
!.gitignore
# …and Obsidian config (rules above already prune the noisy parts)
!.obsidian/
!.obsidian/**

# Hard-deny anything else that managed to land
*.canvas
*.excalidraw
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.zip
*.tar
*.tar.gz
*.7z
*.json
*.jsonl
*.csv
*.tsv
*.xlsx
*.xls
*.docx
*.pptx
*.html
*.htm
*.py
*.sh
*.js
*.ts
*.tsx
*.jsx
*.css
*.yaml
*.yml
*.toml
*.lock
*.claim
*.done
*.mission
*.bak
*.log

# Allow the deny-list to be overridden ONLY for the .obsidian config tree
!.obsidian/**/*.json
!.obsidian/**/*.css
!.obsidian/**/*.js
!.obsidian/**/*.html

# Inner vault Obsidian shell — content kept, app settings excluded
00-SHARED/00-Inbox/vault/.obsidian/
00-SHARED/00-Inbox/vault/.makemd/
00-SHARED/00-Inbox/vault/.space/
00-SHARED/00-Inbox/vault/FONT/
00-SHARED/00-Inbox/vault/Tags/
00-SHARED/00-Inbox/vault/99-Vault-Meta/
