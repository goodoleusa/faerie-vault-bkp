+def _capture_context_pct_at_spawn() -> float | None:
+    """Read current main context fill percentage at spawn-time.
+
+    Resolution order (first hit wins):
+      1. ~/.claude/hooks/state/compact-risk.json   (corrected_pct, canonical)
+      2. ~/.claude/hooks/state/context-phase.json  (raw_pct, fallback)
+      3. ~/.claude/hooks/state/ctx-prev.json       (pct, last-known)
+
+    Fail-open: returns None if no source available. NEVER raises — measurement
+    must never break spawning.
+    """
+    try:
+        claude_home = Path(os.environ.get("CLAUDE_HOME", str(Path.home() / ".claude")))
+        state = claude_home / "hooks" / "state"
+        for filename, key in (
+            ("compact-risk.json", "corrected_pct"),
+            ("context-phase.json", "raw_pct"),
+            ("ctx-prev.json", "pct"),
+        ):
+            f = state / filename
+            if not f.exists():
+                continue
+            try:
+                data = json.loads(f.read_text(encoding="utf-8"))
+            except (json.JSONDecodeError, OSError):
+                continue
+            if key in data:
+                try:
+                    return float(data[key])
+                except (TypeError, ValueError):
+                    continue
+    except Exception:
+        pass
+    return None
+
+
+def _append_session_context_log(
+    session_id: str,
+    wave: str,
+    context_pct: float | None,
+    task_id: str | None,
+    agent_type: str,
+) -> None:
+    """Append a context-snapshot entry to per-session jsonl in memory/forensics/.
+
+    File: ~/.claude/memory/forensics/session-{sid}.jsonl
+    Schema: {ts, event, wave, wave_id, context_pct, task_id, agent_type, session_id}
+
+    Fail-open: any error swallowed.
+    """
+    try:
+        claude_home = Path(os.environ.get("CLAUDE_HOME", str(Path.home() / ".claude")))
+        outdir = claude_home / "memory" / "forensics"
+        outdir.mkdir(parents=True, exist_ok=True)
+        sid8 = (session_id or "unknown")[:8]
+        path = outdir / f"session-{sid8}.jsonl"
+        entry = {
+            "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
+            "event": "spawn_context_snapshot",
+            "wave": wave,
+            "wave_id": wave,
+            "context_pct": context_pct,
+            "task_id": task_id,
+            "agent_type": agent_type,
+            "session_id": session_id,
+        }
+        with open(path, "a", encoding="utf-8") as f:
+            f.write(json.dumps(entry) + "\n")
+    except Exception:
+        pass

