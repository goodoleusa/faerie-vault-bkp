# ═══════════════════════════════════════════════════════════════════════════
# FAERIE-VAULT — Runtime Environment (sister Obsidian vault for faerie)
# ═══════════════════════════════════════════════════════════════════════════
# Legend:
#   [REQUIRED]            → must be set for the app/scripts to run
#   [OPTIONAL: <feature>] → only needed if you use that feature
#   [DEV] / [PROD]        → environment-specific
#   [SECRET]              → do NOT share. Rotate if leaked.
#
# This vault is mostly markdown content; the small set of scripts under
# scripts/ and install/ need only path + Claude API config.
#
# Repo is private. .env is committed for convenience. If repo goes public,
# add .env to .gitignore BEFORE pushing.
# ═══════════════════════════════════════════════════════════════════════════


# ─── VAULT + SIBLING PATHS ──────────────────────────────────────────────────
# [REQUIRED for sync scripts] Where the vault and its sibling repo live.

FAERIE_VAULT="/mnt/d/0local/gitrepos/faerie-vault"
FAERIE_REPO="/mnt/d/0local/gitrepos/faerie2"
FAERIE_REPO_ROOT="${FAERIE_REPO}"

# [OPTIONAL: cybertemplate cross-link]
CT_VAULT="/mnt/d/0local/gitrepos/cybertemplate"


# ─── CLAUDE / OPENHANDS PATHS ───────────────────────────────────────────────
# [REQUIRED for hooks + .claude/scripts]

CLAUDE_HOME="/mnt/d/0LOCAL/.claude"


# ─── ANTHROPIC API ──────────────────────────────────────────────────────────
# [OPTIONAL: vault-side Claude jobs] Only set if you run Claude scripts in this
# repo directly. The main faerie2 .env already has this. Leave blank to inherit.

ANTHROPIC_API_KEY=                 # [SECRET][OPTIONAL] — leave blank to inherit from shell


# ─── DEV / DEBUG ────────────────────────────────────────────────────────────
# [OPTIONAL] Set only when debugging vault sync scripts.

FAERIE_LOG_LEVEL=INFO              # DEBUG | INFO | WARN | ERROR
FAERIE_DRY_RUN=false               # true skips writes (safe to test sync scripts)
